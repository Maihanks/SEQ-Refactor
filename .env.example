# Copy this file to `.env` and fill in real values. `.env` is gitignored
# and must never be committed.

# Required for the LLM generator (seqrefactor/generate/llm.py). Without it,
# the pipeline still runs end to end using the deterministic RuleBaseline
# generator (seqrefactor/generate/baseline.py).
OPENAI_API_KEY=

# Model used by the LLM adapter.
SEQREFACTOR_LLM_MODEL=gpt-4.1-mini

# Seed for deterministic generation, sampling, and dataset synthesis (NFR-2).
SEQREFACTOR_SEED=20260101

# Optional: base URL / auth for a running SonarQube server used by
# seqrefactor/detect/sonar.py. Leave unset to use the built-in tree-sitter
# detector (seqrefactor/detect/native.py) instead.
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=
